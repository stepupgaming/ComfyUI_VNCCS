{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@workspace/core/*": ["./src/*"],
      "@workspace/ui/*": ["../ui/src/*"],
      "@workspace/vnccs": ["../vnccs/src/index.ts"],
      "@workspace/vnccs/*": ["../vnccs/src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
