{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNCCS Studio",
  "version": "0.1.0",
  "identifier": "com.vnccs.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../node_modules/.studio-next"
  },
  "app": {
    "windows": [
      {
        "title": "VNCCS Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
